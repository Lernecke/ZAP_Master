# Vorlage fuer .env.test.local (Abschnitt 10.1 des Architektur-Briefings).
# .env.test.local selbst ist ueber ".env*" in .gitignore und wird NIE eingecheckt.
# Werte hier sind rein synthetische, lokale Test-Zugangsdaten ohne Bezug zu echten Konten --
# scripts/seed-e2e-users.mjs legt die passenden Nutzer nach jedem `supabase db reset --local`
# ueber die Supabase Admin API in der lokalen Instanz an.

E2E_USER_EMAIL=e2e.user@zap.local.test
E2E_USER_PASSWORD=e2e-local-only-not-a-real-secret
E2E_ADMIN_EMAIL=e2e.admin@zap.local.test
E2E_ADMIN_PASSWORD=e2e-local-only-not-a-real-secret
